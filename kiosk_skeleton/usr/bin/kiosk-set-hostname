#!/bin/bash

HOSTNAME=$(get-ini /boot/firmware/kioskbrowser.ini general hostname kiosk)
if [ -n "${HOSTNAME}" ]
then
	echo "${HOSTNAME}" > /kiosk-tmp/hostname
	hostnamectl --transient hostname "${HOSTNAME}"

	echo "127.0.0.1	localhost" > /kiosk-tmp/hosts
	echo "::1		localhost ip6-localhost ip6-loopback" >> /kiosk-tmp/hosts
	echo "ff02::1		ip6-allnodes" >> /kiosk-tmp/hosts
	echo "ff02::2		ip6-allrouters" >> /kiosk-tmp/hosts
	echo "" >> /kiosk-tmp/hosts
	echo "127.0.1.1		${HOSTNAME}" >> /kiosk-tmp/hosts
fi
