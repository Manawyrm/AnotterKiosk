#!/bin/bash

# configure DNS
echo "nameserver 8.8.8.8" > /etc/resolv.conf
echo "nameserver 2001:4860:4860::8888" >> /etc/resolv.conf
echo "nameserver 8.8.4.4" >> /etc/resolv.conf
echo "nameserver 2001:4860:4860::8844" >> /etc/resolv.conf

if [ -f "/boot/firmware/wpa_supplicant.conf" ]; then
	ln -s /boot/firmware/wpa_supplicant.conf /tmp/wpa_supplicant.conf
	exit
fi

WIFI_SSID=$(get-ini /boot/firmware/kioskbrowser.ini wifi ssid)
WIFI_PSK=$(get-ini /boot/firmware/kioskbrowser.ini wifi psk)
WIFI_COUNTRY=$(get-ini /boot/firmware/kioskbrowser.ini wifi country)

if [ -n "${WIFI_SSID}" ]
then
	echo "country=${WIFI_COUNTRY}" > /tmp/wpa_supplicant.conf
	echo "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev" >> /tmp/wpa_supplicant.conf
	echo "update_config=1" >> /tmp/wpa_supplicant.conf
	echo "network={" >> /tmp/wpa_supplicant.conf
	echo "	ssid=\"${WIFI_SSID}\"" >> /tmp/wpa_supplicant.conf
	if [ -n "${WIFI_PSK}" ]
	then
		echo "	psk=\"${WIFI_PSK}\"" >> /tmp/wpa_supplicant.conf
	else
		echo "	key_mgmt=NONE" >> /tmp/wpa_supplicant.conf
	fi
	echo "}" >> /tmp/wpa_supplicant.conf
fi

rfkill unblock all || true

# Determine the wireless interface to use. The "interface" option in
# kioskbrowser.ini wins; otherwise the USB WiFi adapter (wlan1) is preferred
# over the built-in WiFi (wlan0).
PREFERRED=$(get-ini /boot/firmware/kioskbrowser.ini wifi interface)
if [ -n "${PREFERRED}" ] && [ ! -d "/sys/class/net/${PREFERRED}" ]; then
	PREFERRED=
fi
if [ -z "${PREFERRED}" ]; then
	if [ -d /sys/class/net/wlan1 ]; then
		PREFERRED=wlan1
	else
		PREFERRED=wlan0
	fi
fi

# Only one wireless interface should be active at a time. Bring the preferred
# one up (if it isn't already) and take every other wireless interface down.
ifup "${PREFERRED}" 2>/dev/null || true
for WLAN in wlan0 wlan1; do
	if [ "${WLAN}" != "${PREFERRED}" ] && [ -d "/sys/class/net/${WLAN}" ]; then
		ip link set "${WLAN}" down 2>/dev/null || true
	fi
done

# Disable Wi-Fi power management on the active interface
iw "${PREFERRED}" set power_save off 2>/dev/null || true
