#!/bin/bash

# configure DNS
if [ -f "/boot/firmware/resolv.conf" ]; then
	cat /boot/firmware/resolv.conf > /kiosk-tmp/resolv.conf
else
	echo "nameserver 8.8.8.8" > /kiosk-tmp/resolv.conf
	echo "nameserver 2001:4860:4860::8888" >> /kiosk-tmp/resolv.conf
	echo "nameserver 8.8.4.4" >> /kiosk-tmp/resolv.conf
	echo "nameserver 2001:4860:4860::8844" >> /kiosk-tmp/resolv.conf
fi


if [ -f "/boot/firmware/wpa_supplicant.conf" ]; then
	ln -s /boot/firmware/wpa_supplicant.conf /kiosk-tmp/wpa_supplicant.conf
	exit
fi

WIFI_SSID=$(get-ini /boot/firmware/kioskbrowser.ini wifi ssid)
WIFI_PSK=$(get-ini /boot/firmware/kioskbrowser.ini wifi psk)
WIFI_COUNTRY=$(get-ini /boot/firmware/kioskbrowser.ini wifi country)

if [ -n "${WIFI_SSID}" ]
then
	echo "country=${WIFI_COUNTRY}" > /kiosk-tmp/wpa_supplicant.conf
	echo "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev" >> /kiosk-tmp/wpa_supplicant.conf
	echo "update_config=1" >> /kiosk-tmp/wpa_supplicant.conf
	echo "network={" >> /kiosk-tmp/wpa_supplicant.conf
	echo "	ssid=\"${WIFI_SSID}\"" >> /kiosk-tmp/wpa_supplicant.conf
	if [ -n "${WIFI_PSK}" ]
	then
		echo "	psk=\"${WIFI_PSK}\"" >> /kiosk-tmp/wpa_supplicant.conf
	else
		echo "	key_mgmt=NONE" >> /kiosk-tmp/wpa_supplicant.conf
	fi
	echo "}" >> /kiosk-tmp/wpa_supplicant.conf
fi

rfkill unblock all || true
iw wlan0 set power_save off || true
