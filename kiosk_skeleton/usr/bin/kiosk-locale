#!/bin/bash
TIMEZONE=$(get-ini /boot/firmware/kioskbrowser.ini general timezone UTC)
ln -fs "/usr/share/zoneinfo/${TIMEZONE}" /kiosk-tmp/localtime

LAYOUT=$(get-ini /boot/firmware/kioskbrowser.ini general keyboard_layout us)
echo "XKBMODEL=\"pc105\"" > /kiosk-tmp/keyboard
echo "XKBLAYOUT=\"${LAYOUT}\"" >> /kiosk-tmp/keyboard
echo "XKBVARIANT=\"\"" >> /kiosk-tmp/keyboard
echo "XKBOPTIONS=\"\"" >> /kiosk-tmp/keyboard
echo "BACKSPACE=\"guess\"" >> /kiosk-tmp/keyboard

setupcon -k -f --force -v
udevadm trigger --subsystem-match=input --action=change
